# Search noise: keeps binary/data blobs out of `rg`, `fd`, and agent file listings.
# Targeted search inside an excluded path is still possible: rg --no-ignore <path>

# Build output and tool caches
build/
**/build/
.dart_tool/
.opencode/
*.log

# Screenshots and binary assets. Nothing here is absent: assets/images/unit_2..5_hint.png are
# loaded at runtime (passed as `hintPath`), app_icon*.png are flutter_launcher_icons build
# inputs, and home_illustration.png is referenced by nothing. These entries only keep binaries
# out of search output — they do not affect the bundle.
screenshots/
assets/images/
*.png
*.jpg
*.jpeg
*.ico
*.ttf
*.wav
*.mp3
