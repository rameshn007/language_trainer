[{"portuguese": "Olá, como você está?", "english": "Hello, how are you?"}, {"portuguese": "Obrigado por sua ajuda.", "english": "Thank you for your help."}, {"portuguese": "Eu não entendo.", "english": "I don't understand."}, {"portuguese": "Posso ajudar?", "english": "Can I help?"}, {"portuguese": "Qual é o seu nome?", "english": "What is your name?"}, {"portuguese": "Meu nome é...", "english": "My name is..."}, {"portuguese": "Eu gosto de...", "english": "I like..."}, {"portuguese": "Onde está o banheiro?", "english": "Where is the bathroom?"}, {"portuguese": "Quanto custa?", "english": "How much does it cost?"}, {"portuguese": "Estou perdido.", "english": "I am lost."}, {"portuguese": "Eu quero um café.", "english": "I want a coffee."}, {"portuguese": "Isso é muito caro.", "english": "This is too expensive."}, {"portuguese": "Eu não falo português.", "english": "I don't speak Portuguese."}, {"portuguese": "Como se chama isso?", "english": "What is this called?"}, {"portuguese": "Você fala inglês?", "english": "Do you speak English?"}, {"portuguese": "Estou com fome.", "english": "I am hungry."}, {"portuguese": "Estou com sede.", "english": "I am thirsty."}, {"portuguese": "Onde é o restaurante?", "english": "Where is the restaurant?"}, {"portuguese": "Preciso de ajuda.", "english": "I need help."}, {"portuguese": "Estou bem, obrigado.", "english": "I'm fine, thank you."}]
